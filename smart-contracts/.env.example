# QuaiForge — smart-contracts environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is listed in .gitignore.

# ---------------------------------------------------------------------------
# Deployer wallet private key (no 0x prefix required)
# Fund this address from the Orchard faucet before running any deployment:
#   https://orchard.faucet.quai.network
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ---------------------------------------------------------------------------
# Orchard testnet RPC endpoint — Cyprus-1 shard
# Default is already set in hardhat.config.js; override here only if you are
# targeting a different shard, a WSS endpoint, or a local node.
#   WSS (for live event subscriptions): wss://orchard.rpc.quai.network/cyprus1
# ---------------------------------------------------------------------------
ORCHARD_RPC_URL=https://orchard.rpc.quai.network/cyprus1

# ---------------------------------------------------------------------------
# Merchant wallet address
# Used by the deploy script to log and verify deployment context.
# Set to the address that will receive payments in your demo.
# ---------------------------------------------------------------------------
MERCHANT_ADDRESS=0xYourMerchantAddressHere

# ---------------------------------------------------------------------------
# Deployed PaymentRegistry contract address
# Populated after running `npm run deploy`.
# Used by the frontend (paymentRegistry.ts) to connect to the live contract.
# ---------------------------------------------------------------------------
CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Quaiscan API key — required for automated source verification (optional)
# Get one at https://orchard.quaiscan.io after connecting your wallet.
# Leave blank to skip automated verification; manual verification still works.
# ---------------------------------------------------------------------------
QUAISCAN_API_KEY=
