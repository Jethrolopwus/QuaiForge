# QuaiForge smart-contracts — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Deployer wallet private key (no 0x prefix required)
# Fund this address from the Orchard faucet before running any deployment:
#   https://orchard.faucet.quai.network
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ---------------------------------------------------------------------------
# Orchard testnet RPC endpoint — Cyprus-1 shard
# Default value is already set in hardhat.config.js; override here only if
# you are targeting a different shard or a local node.
# ---------------------------------------------------------------------------
ORCHARD_RPC_URL=https://orchard.rpc.quai.network/cyprus1

# ---------------------------------------------------------------------------
# Quaiscan API key — required for automated contract verification (§6.4)
# Get one from https://orchard.quaiscan.io after connecting your wallet.
# Leave blank to skip automated verification; manual verification still works.
# ---------------------------------------------------------------------------
QUAISCAN_API_KEY=

# ---------------------------------------------------------------------------
# SolidityX compiler path — only needed if you are using QIP-2 opcodes.
# Leave blank for standard Solidity 0.8.20 compilation.
# ---------------------------------------------------------------------------
# SOLIDITYX_COMPILER_PATH=/path/to/solidityx
