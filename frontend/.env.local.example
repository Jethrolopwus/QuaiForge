# QuaiForge frontend environment
# Copy to .env.local and fill in after deploying PaymentRegistry
# (see smart-contracts/README section "Deploy to Orchard Testnet")

# Deployed PaymentRegistry address on Orchard — from deploy-addresses.json
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Merchant wallet that receives payments (same as MERCHANT_ADDRESS in contracts .env)
NEXT_PUBLIC_MERCHANT_ADDRESS=

# Orchard endpoints (defaults are fine)
NEXT_PUBLIC_ORCHARD_RPC_HTTP=https://orchard.rpc.quai.network/cyprus1
NEXT_PUBLIC_ORCHARD_RPC_WSS=wss://orchard.rpc.quai.network/cyprus1
